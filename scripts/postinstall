#!/bin/bash
set -e

login_user=`/usr/bin/stat -f%Su /dev/console`
app_root="${DSTROOT}/Paretly.app"
executable="${app_root}/Contents/MacOS/Paretly"
shared_data="${app_root}/Contents/SharedSupport"

install_applications_launcher() {
    local archive="${app_root}/Contents/Resources/ParetlyLauncher.tar"
    local dest="/Applications/Paretly.app"
    local stage
    local reg="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
    if [ ! -f "${archive}" ]; then
        echo "Paretly launcher archive is missing; Launchpad app was not installed." >&2
        return 0
    fi
    stage="$(mktemp -d)"
    tar -xf "${archive}" -C "${stage}"
    if [ ! -d "${stage}/Paretly.app" ]; then
        rm -rf "${stage}"
        echo "Paretly launcher archive has no Paretly.app" >&2
        exit 1
    fi
    if [ "$(id -u)" -eq 0 ]; then
        rm -rf "${dest}"
        /usr/bin/ditto "${stage}/Paretly.app" "${dest}"
        chown -R root:wheel "${dest}"
        chmod -R a+rX "${dest}"
    elif [ -w /Applications ]; then
        rm -rf "${dest}"
        /usr/bin/ditto "${stage}/Paretly.app" "${dest}"
    else
        /usr/bin/sudo /bin/rm -rf "${dest}"
        /usr/bin/sudo /usr/bin/ditto "${stage}/Paretly.app" "${dest}"
    fi
    rm -rf "${stage}"
    if [ -x "${reg}" ]; then
        /usr/bin/sudo -u "${login_user}" "${reg}" -f "${dest}" || true
    fi
}

stop_paretly() {
    /usr/bin/killall Paretly >/dev/null 2>&1 || true
    /usr/bin/killall ParetlyLauncher >/dev/null 2>&1 || true
    /bin/sleep 0.2
    /usr/bin/killall -KILL Paretly >/dev/null 2>&1 || true
    /usr/bin/killall -KILL ParetlyLauncher >/dev/null 2>&1 || true
}

relaunch_paretly() {
    if [ -z "${login_user}" ] || [ "${login_user}" = "root" ] || [ "${login_user}" = "loginwindow" ]; then
        return 0
    fi
    local uid
    uid="$(/usr/bin/id -u "${login_user}" 2>/dev/null || true)"
    if [ -z "${uid}" ]; then
        return 0
    fi
    # Detach from the installer. `open` returns immediately; the input method keeps running.
    /bin/launchctl asuser "${uid}" /usr/bin/sudo -u "${login_user}" /usr/bin/open -g "${app_root}" >/dev/null 2>&1 || \
        /usr/bin/sudo -u "${login_user}" /usr/bin/open -g "${app_root}" >/dev/null 2>&1 || true
}

trap relaunch_paretly EXIT

stop_paretly

install_applications_launcher

"${executable}" --register-input-source

if [ -z "${RIME_NO_PREBUILD}" ]; then
    pushd "${shared_data}" > /dev/null
    "${executable}" --build
    popd > /dev/null
fi && (
    /usr/bin/sudo -u "${login_user}" "${executable}" --enable-input-source
    /usr/bin/sudo -u "${login_user}" "${executable}" --select-input-source
)
