#!/bin/bash

DERIVED_DATA_PATH=$1
BUNDLE_IDENTIFIER='com.qiuzekun.inputmethod.Paretly'
INSTALL_LOCATION='/Library/Input Methods'

cd "$(dirname $0)"
source common.sh

# CI sets CURRENT_PROJECT_VERSION to github.run_number so each package is newer
# than the last one. A local MARKETING_VERSION build still uses that string.
if [ -n "${CURRENT_PROJECT_VERSION:-}" ]; then
    version="${CURRENT_PROJECT_VERSION}"
elif [ -n "${MARKETING_VERSION:-}" ]; then
    version="${MARKETING_VERSION}"
else
    version="$(get_app_version)"
fi

pkgbuild \
    --info PackageInfo \
    --root "${PROJECT_ROOT}/${DERIVED_DATA_PATH}/Build/Products/Release" \
    --filter '.*\.swiftmodule$' \
    --component-plist Squirrel-component.plist \
    --identifier "${BUNDLE_IDENTIFIER}" \
    --version "${version}" \
    --install-location "${INSTALL_LOCATION}" \
    --scripts "${PROJECT_ROOT}/scripts" \
    Paretly.pkg
